# DeepSeek API 配置（必填）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务配置（可选）
HOST=127.0.0.1
PORT=8000

# 文件操作沙箱根目录（可选，默认项目根目录）
# WORKSPACE_ROOT=C:\Users\Administrator\WorkBuddy\2026-08-12-20-39-45

# 目录操作工具可管理的特定目录（可选，默认项目根/target_dir）
# TARGET_DIR=C:\path\to\your\folder

# RAG 文档检索目录（可选，默认项目根/docs）
# DOC_ROOT=C:\path\to\your\docs

# 运行环境（可选，默认按 os.name 自动识别；可强制设为 Windows / Linux / macOS）
# OS=Windows

# 单次对话最大工具调用轮数（可选，默认 8）
MAX_AGENT_ITERATIONS=8

# SQLite 数据库路径（可选）
# DB_PATH=mini_wb.db
